# Copy to .env and fill in. Never commit the real .env file.

# SQLite by default (zero setup for local dev). For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/jdk_erp
DATABASE_URL=sqlite:///./dev.db

# Required -- the app refuses to start without this. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Idle timeout for the refresh-token "session" -- a client that doesn't
# call /refresh within this window is logged out even if the absolute
# timeout above hasn't been hit yet. Default: 12 hours.
SESSION_IDLE_TIMEOUT_MINUTES=720

LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=

# Set true only when this app terminates TLS itself (not behind a
# TLS-terminating load balancer/proxy, which is equally valid and more
# common). Redirects plain HTTP to HTTPS and enables HSTS.
FORCE_HTTPS=false

# DEBUG is development-only -- never set this in production.
LOG_LEVEL=INFO

# A request slower than this logs at WARN with its duration.
SLOW_REQUEST_THRESHOLD_MS=1000
