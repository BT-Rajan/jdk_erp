# Copy to .env and fill in. Never commit the real .env file.

# SQLite by default (zero setup for local dev). For MySQL:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/jdk_erp
DATABASE_URL=sqlite:///./dev.db

# Required -- the app refuses to start without this. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW_MINUTES=15

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
